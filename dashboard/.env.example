# PhishSentinel AI dashboard — build-time default API base.
# Can also be changed at runtime from the Settings tab (stored in the
# browser's localStorage) without rebuilding — this env var only sets
# the initial default, useful for deploying the dashboard pre-pointed
# at a specific backend (e.g. your Render/HF Spaces deployment URL).
VITE_API_BASE=http://localhost:8000
