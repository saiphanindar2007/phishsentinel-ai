# Copy to .env  (docker compose reads it automatically). NEVER commit .env.
# Generate strong secrets with:  openssl rand -hex 32

# REQUIRED
POSTGRES_PASSWORD=
API_KEY=            # clients: dashboard + browser extension
ADMIN_API_KEY=      # operators only; must differ from API_KEY

# Optional
CORS_ORIGINS=http://localhost:8080
RETENTION_DAYS=0    # delete verdicts older than N days at startup (0 = keep forever)
