# Backend settings for local (non-Docker) runs: copy to backend/.env.
# Every value has a safe default; an empty file works for development.

ENVIRONMENT=development          # development | test | production
                                 # production REFUSES to start without API keys / explicit CORS
DATABASE_URL=sqlite:///./phishsentinel.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/phishsentinel

# --- Fusion weights (must sum to 1.0) ---
WEIGHT_URL=0.30
WEIGHT_NLP=0.30
WEIGHT_VISUAL=0.20
WEIGHT_REPUTATION=0.20
SUSPICIOUS_THRESHOLD=0.4
PHISHING_THRESHOLD=0.7

# --- Security ---
API_KEY=                         # guards /analyze, /feedback, /events (blank = open, dev only)
ADMIN_API_KEY=                   # guards /lists, /admin, /metrics, /system (must differ from API_KEY)
CORS_ORIGINS=*                   # comma-separated origins; '*' is rejected in production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_HEADERS=false        # true ONLY behind a proxy you control (nginx, load balancer)

# --- Performance ---
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=5000
MAX_BATCH_SIZE=100
MAX_REQUEST_BYTES=8388608
MAX_SSE_SUBSCRIBERS=50
LIST_REFRESH_SECONDS=30

# --- Observability / data ---
LOG_LEVEL=INFO
LOG_JSON=false                   # defaults to true in production
DOCS_ENABLED=true                # defaults to false in production
RETENTION_DAYS=0
SHAP_ENABLED=true
